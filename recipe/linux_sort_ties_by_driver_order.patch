Break ties in the Linux physical device sort by driver discovery order so the
driver whose manifest was found first (earlier search path) enumerates first.
Related: https://github.com/KhronosGroup/Vulkan-Loader/issues/2017

diff --git a/loader/loader_linux.c b/loader/loader_linux.c
index e9520b0..c0006ae 100644
--- a/loader/loader_linux.c
+++ b/loader/loader_linux.c
@@ -67,12 +67,28 @@ int32_t device_type_compare(VkPhysicalDeviceType a, VkPhysicalDeviceType b) {
     return 0;
 }
 
+// Compare the order in which the drivers owning two devices were found.  The scanned
+// driver list is kept in manifest search order, so the driver from the earlier search
+// path (e.g. VK_DRIVER_FILES or an XDG/prefix directory before /usr/share) wins a tie.
+static int32_t driver_order_compare(const struct loader_icd_term *a, const struct loader_icd_term *b) {
+    if (NULL == a || NULL == b || NULL == a->scanned_icd || NULL == b->scanned_icd) {
+        return 0;
+    }
+    if (a->scanned_icd < b->scanned_icd) {
+        return -1;
+    } else if (b->scanned_icd < a->scanned_icd) {
+        return 1;
+    }
+    return 0;
+}
+
 // Used to compare two devices and determine which one should have priority.  The criteria is
 // simple:
 //   1) Default device ALWAYS wins
 //   2) Sort by type
 //   3) Sort by PCI bus ID
 //   4) Ties broken by device_ID XOR vendor_ID comparison
+//   5) Ties broken by the order the owning drivers were found
 int32_t compare_devices(const void *a, const void *b) {
     struct LinuxSortedDeviceInfo *left = (struct LinuxSortedDeviceInfo *)a;
     struct LinuxSortedDeviceInfo *right = (struct LinuxSortedDeviceInfo *)b;
@@ -130,7 +146,7 @@ int32_t compare_devices(const void *a, const void *b) {
     } else if (right_xord_dev_vend < left_xord_dev_vend) {
         return 1;
     }
-    return 0;
+    return driver_order_compare(left->icd_term, right->icd_term);
 }
 
 // Used to compare two device groups and determine which one should have priority.
@@ -140,6 +156,7 @@ int32_t compare_devices(const void *a, const void *b) {
 //   2) Group with the best device type for device 0 wins
 //   3) Group with best PCI bus ID for device 0 wins
 //   4) Ties broken by group device 0 device_ID XOR vendor_ID comparison
+//   5) Ties broken by the order the group device 0 drivers were found
 int32_t compare_device_groups(const void *a, const void *b) {
     struct loader_physical_device_group_term *grp_a = (struct loader_physical_device_group_term *)a;
     struct loader_physical_device_group_term *grp_b = (struct loader_physical_device_group_term *)b;
@@ -201,7 +218,7 @@ int32_t compare_device_groups(const void *a, const void *b) {
     } else if (right_xord_dev_vend < left_xord_dev_vend) {
         return 1;
     }
-    return 0;
+    return driver_order_compare(left->icd_term, right->icd_term);
 }
 
 // Search for the default device using the loader environment variable.
@@ -362,6 +379,7 @@ VkResult linux_sort_physical_device_groups(struct loader_instance *inst, uint32_
 
             sorted_group_term[group].internal_device_info[gpu].physical_device =
                 sorted_group_term[group].group_props.physicalDevices[gpu];
+            sorted_group_term[group].internal_device_info[gpu].icd_term = icd_term;
             sorted_group_term[group].internal_device_info[gpu].has_pci_bus_info = false;
 
             icd_term->dispatch.GetPhysicalDeviceProperties(sorted_group_term[group].internal_device_info[gpu].physical_device,
